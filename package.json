{
  "name": "places-maplibre-base",
  "version": "0.0.1",
  "description": "Shared MapLibre GL implementation for Places map providers.",
  "main": "main.js",
  "types": "types/main.d.ts",
  "exports": {
    ".": {
      "types": "./types/main.d.ts",
      "require": "./main.js",
      "import": "./main.js",
      "default": "./main.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "lint": "eslint src --ext .ts,.tsx,.js,.jsx",
    "dev": "node esbuild.config.mjs development",
    "clean:types": "node -e \"require('fs').rmSync('types',{recursive:true,force:true})\"",
    "build": "npm run clean:types && tsc --emitDeclarationOnly && node esbuild.config.mjs production",
    "rename": "node -e \"require('fs').rename('main.css', 'styles.css', () => { })\"",
    "watch": "node esbuild.config.mjs watch",
    "prepare": "node -e \"process.exit(require('fs').existsSync('main.js') ? 0 : 1)\" || npm run build",
    "typecheck": "tsc --noEmit --pretty false --skipLibCheck",
    "typecheck:v5": "tsc --noEmit --pretty false -p tsconfig.v5.json"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "maps",
    "maplibre"
  ],
  "author": "Bob Stanton",
  "license": "AGPL-3.0-only",
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "esbuild": "^0.28.1",
    "eslint": "^8.57.1",
    "maplibre-gl-v5": "npm:maplibre-gl@^5.24.0",
    "obsidian": "^1.13.1",
    "tslib": "^2.8.1",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@types/geojson": "^7946.0.16",
    "maplibre-gl": "^6.0.0"
  },
  "overrides": {
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "places-shared": "*"
  },
  "peerDependenciesMeta": {
    "places-shared": {
      "optional": true
    }
  }
}
